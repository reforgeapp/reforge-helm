{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "publicURL": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ttlHours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "authentik": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicURL": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$"
        },
        "existingSecret": {
          "type": "string"
        },
        "database": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sslMode": {
              "enum": [
                "disable",
                "require",
                "verify-ca",
                "verify-full"
              ]
            }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "clientID": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "runtimeUser": {
          "type": "string",
          "minLength": 1
        },
        "migratorUser": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "enum": [
            "require",
            "verify-ca",
            "verify-full"
          ]
        }
      }
    },
    "runner": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kubernetes": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "createNamespace": {
              "type": "boolean"
            },
            "runtimeClassName": {
              "type": "string"
            },
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 268435456,
              "maximum": 68719476736
            },
            "diskBytes": {
              "type": "integer",
              "minimum": 16777216,
              "maximum": 1099511627776
            },
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "images": {
              "type": "object",
              "required": [
                "go",
                "javascript",
                "python"
              ],
              "additionalProperties": false,
              "properties": {
                "go": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
                },
                "javascript": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
                },
                "python": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sectionName"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              },
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "sectionName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        },
        "httpRedirectParentRefs": {
          "$ref": "#/properties/gatewayAPI/properties/parentRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "parentRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgresql": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "postgresql": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "externalDatabase": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authentik": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "oidc": {
            "properties": {
              "issuer": {
                "type": "string",
                "pattern": "^https://[^ ]+$"
              },
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
